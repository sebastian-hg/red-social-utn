                  "const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.test('Vence a los 15 minutos', () => pm.expect(payload.exp - payload.iat).to.eql(900));",
