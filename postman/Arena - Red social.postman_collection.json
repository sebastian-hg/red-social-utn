  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera un sufijo único por ejecución para no chocar con usuarios existentes",
          "if (!pm.collectionVariables.get('sufijo')) {",
          "  pm.collectionVariables.set('sufijo', Date.now().toString().slice(-6));",
          "}"
        ]
      }
    }
