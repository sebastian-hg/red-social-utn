PORT=3000
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/
MONGO_DB=UTN
# Clave para firmar los JWT: usar un texto largo y aleatorio
JWT_SECRET=<cambiar-por-un-secreto-largo-y-aleatorio>
# URL pública del back, se usa para armar la URL de las imágenes subidas
BASE_URL=http://localhost:3000
# Orígenes permitidos separados por coma
CORS_ORIGIN=http://localhost:4200
